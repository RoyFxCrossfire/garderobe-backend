# Server
PORT=3000
# Publieke basis-URL van deze backend (nodig voor Mollie redirect + webhook URLs)
# Lokaal testen: gebruik ngrok/cloudflared, Mollie kan niet naar localhost webhooken
BASE_URL=https://jouw-domein-of-ngrok-url.example.com
# URL van je frontend, waar de klant na betaling naartoe gaat
FRONTEND_SUCCESS_URL=https://jouw-webshop.example.com/bestelling-bevestigd

# --- Mollie ---
# Te vinden in Mollie Dashboard > Ontwikkelaars > API-sleutels
MOLLIE_API_KEY=test_xxxxxxxxxxxxxxxxxxxxxxxxxx

# --- CJ Dropshipping ---
# Te genereren via CJ personal center > API tab > "Add API"
# Formaat: CJUserNum@api@xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
CJ_API_KEY=CJUserNum@api@xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
# Land vanwaar CJ standaard verstuurt (meestal CN, check jouw CJ-warehouse instelling)
CJ_FROM_COUNTRY_CODE=CN
# Standaard verzendmethode; pas aan op wat CJ voor jouw producten/route aanbiedt
CJ_LOGISTIC_NAME=CJPacket Ordinary
# Vermenigvuldigingsfactor over CJ's inkoopprijs om je verkoopprijs te bepalen.
# 1.6 = 60% marge. Pas aan naar wat voor jouw categorie realistisch is.
PRICE_MARKUP_MULTIPLIER=1.6
