# Server
PORT=3000
# Publieke basis-URL van deze backend (nodig voor webhook URLs)
# Lokaal testen: gebruik ngrok/cloudflared, Stripe kan niet naar localhost webhooken
BASE_URL=https://jouw-domein-of-ngrok-url.example.com
# URL van je frontend, waar de klant na (mislukte) betaling naartoe gaat
FRONTEND_SUCCESS_URL=https://jouw-webshop.example.com/bestelling-bevestigd
FRONTEND_CANCEL_URL=https://jouw-webshop.example.com/afgerekend-geannuleerd

# --- Stripe ---
# Stripe Dashboard > Developers > API keys. Begin met de sk_test_... sleutel.
STRIPE_SECRET_KEY=sk_test_xxxxxxxxxxxxxxxxxxxxxxxxxx
# Stripe Dashboard > Developers > Webhooks > jouw endpoint > Signing secret.
# Lokaal testen: `stripe listen --forward-to localhost:3000/api/webhooks/stripe`
# geeft een tijdelijke whsec_... sleutel in de terminal.
STRIPE_WEBHOOK_SECRET=whsec_xxxxxxxxxxxxxxxxxxxxxxxxxx
# Stripe Tax moet je eenmalig activeren in het Dashboard (Tax > activeren)
# voordat automatic_tax daadwerkelijk btw berekent.

# --- CJ Dropshipping ---
# Te genereren via CJ personal center > API tab > "Add API"
# Formaat: CJUserNum@api@xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
CJ_API_KEY=CJUserNum@api@xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
# Land vanwaar CJ standaard verstuurt (meestal CN, check jouw CJ-warehouse instelling)
CJ_FROM_COUNTRY_CODE=CN
# Standaard verzendmethode; pas aan op wat CJ voor jouw producten/route aanbiedt
CJ_LOGISTIC_NAME=CJPacket Ordinary
# Vermenigvuldigingsfactor over CJ's inkoopprijs om je verkoopprijs te bepalen.
# 1.6 = 60% marge. Pas aan naar wat voor jouw categorie realistisch is.
PRICE_MARKUP_MULTIPLIER=1.6
